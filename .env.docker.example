# Docker Compose — copy to `.env` at repo root
# Uses service hostnames (mongo, redis) from docker-compose.yml

NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=5000
API_PUBLIC_URL=http://localhost:5000
ADMIN_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

ALLOWED_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://mongo:27017/weight_loss
MONGODB_DB=weight_loss

REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=docker_dev_access_secret_min_32_chars__
JWT_REFRESH_SECRET=docker_dev_refresh_secret_min_32_chars_
COOKIE_SECRET=docker_dev_cookie_secret_min_32_chars____

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

ADMIN_SEED_ENABLED=true
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMeDocker123

STORAGE_DRIVER=local
UPLOAD_ROOT=public/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:5000/uploads

API_DOCS_ENABLED=true
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

LOG_LEVEL=info
