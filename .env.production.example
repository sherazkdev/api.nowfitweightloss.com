# Production environment template
# Copy to `.env` on the server. Never commit real secrets.

NODE_ENV=production

APP_NAME=WeightLoss
APP_VERSION=1.0.0

API_HOST=0.0.0.0
API_PORT=5000

# Public URLs (used in cookies, media links, Swagger)
API_PUBLIC_URL=https://api.example.com
ADMIN_PUBLIC_URL=https://admin.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Comma-separated admin UI origins
ALLOWED_ORIGINS=https://admin.example.com

# MongoDB — use auth + TLS in production
MONGODB_URI=mongodb://USER:PASSWORD@mongo-host:27017/weight_loss?authSource=weight_loss
MONGODB_DB=weight_loss

MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# Redis — use auth + TLS where available
REDIS_URL=redis://:PASSWORD@redis-host:6379

JWT_ACCESS_SECRET=GENERATE_64_CHAR_RANDOM_STRING________________
JWT_REFRESH_SECRET=GENERATE_64_CHAR_RANDOM_STRING________________
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=GENERATE_64_CHAR_RANDOM_STRING________________
REFRESH_COOKIE_NAME=wl_refresh
COOKIE_DOMAIN=.example.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Disable after first admin exists
ADMIN_SEED_ENABLED=false
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=DO_NOT_USE_IN_PRODUCTION

# Local uploads on API disk (no AWS)
STORAGE_DRIVER=local
UPLOAD_ROOT=/var/lib/weightloss/uploads
TEMP_UPLOAD_ROOT=/var/lib/weightloss/tmp
PUBLIC_MEDIA_BASE_URL=https://api.example.com/uploads

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
MAX_DATA_UPLOAD_MB=100

CACHE_ENABLED=true
CACHE_DASHBOARD_TTL_SECONDS=60

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_LOGIN_MAX=5

QUEUE_PREFIX=weightloss

# Security
API_DOCS_ENABLED=false
TRUST_PROXY=true
METRICS_ENABLED=true
METRICS_TOKEN=GENERATE_METRICS_SCRAPE_TOKEN_________
LOG_LEVEL=info

SLOW_REQUEST_MS=500
