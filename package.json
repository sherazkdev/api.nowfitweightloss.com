{
  "name": "weightloss-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @weightloss/admin",
    "dev:admin": "npm run dev -w @weightloss/admin",
    "dev:api": "npm run dev -w @weightloss/api",
    "dev:worker": "npm run dev -w @weightloss/worker",
    "build": "npm run build --workspaces --if-present",
    "build:admin": "npm run build -w @weightloss/admin",
    "build:api": "npm run build -w @weightloss/config -w @weightloss/contracts -w @weightloss/logger -w @weightloss/shared -w @weightloss/database -w @weightloss/cache -w @weightloss/auth -w @weightloss/storage -w @weightloss/queue -w @weightloss/metrics && npm run build -w @weightloss/api",
    "build:worker": "npm run build -w @weightloss/config -w @weightloss/contracts -w @weightloss/logger -w @weightloss/shared -w @weightloss/database -w @weightloss/cache -w @weightloss/storage -w @weightloss/queue -w @weightloss/metrics && npm run build -w @weightloss/worker",
    "build:client": "npm run build -w @weightloss/client",
    "start:api": "npm run start -w @weightloss/api",
    "start:worker": "npm run start -w @weightloss/worker",
    "start:admin": "npm run start -w @weightloss/admin",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api worker admin",
    "lint": "npm run lint -w @weightloss/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:seed-tools": "npm run build -w @weightloss/config -w @weightloss/contracts -w @weightloss/logger -w @weightloss/shared -w @weightloss/database -w @weightloss/cache -w @weightloss/auth",
    "seed": "npm run build:seed-tools && tsx scripts/seed.ts",
    "db:reset": "npm run build:seed-tools && tsx scripts/seed.ts --reset",
    "db:indexes": "npm run build -w @weightloss/config -w @weightloss/contracts -w @weightloss/logger -w @weightloss/shared -w @weightloss/database && tsx scripts/create-indexes.ts",
    "db:verify-indexes": "npm run build -w @weightloss/config -w @weightloss/contracts -w @weightloss/logger -w @weightloss/shared -w @weightloss/database && tsx scripts/verify-indexes.ts",
    "db:seed-admin": "npm run seed",
    "storage:migrate-local-to-s3": "npm run build -w @weightloss/config -w @weightloss/storage && tsx scripts/migrate-local-to-s3.ts",
    "postinstall": "node scripts/ensure-native-deps.mjs"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@tailwindcss/oxide-win32-arm64-msvc": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "lightningcss-linux-arm64-musl": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-arm64-msvc": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
