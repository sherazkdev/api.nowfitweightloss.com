# Weight Loss Platform — environment variables
# Copy to `.env` and replace CHANGE_ME values. Never commit `.env`.

NODE_ENV=development

APP_NAME=WeightLoss
APP_VERSION=1.0.0

API_HOST=0.0.0.0
API_PORT=5000

API_PUBLIC_URL=http://localhost:5000
ADMIN_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

MONGODB_URI=mongodb://weightloss_api:CHANGE_ME@127.0.0.1:27017/weight_loss?authSource=weight_loss
MONGODB_DB=weight_loss

MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000

REDIS_URL=redis://weightloss_api:CHANGE_ME@127.0.0.1:6379

REDIS_CACHE_URL=
REDIS_QUEUE_URL=
REDIS_AUTH_URL=

REDIS_KEY_PREFIX=weightloss:

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_MIN_16_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_MIN_16_CHARS

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

JWT_ISSUER=weightloss-api
JWT_AUDIENCE=weightloss-admin

COOKIE_SECRET=CHANGE_ME_COOKIE_MIN_16_CHARS
REFRESH_COOKIE_NAME=wl_refresh
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ADMIN_SEED_ENABLED=true
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

STORAGE_DRIVER=local

UPLOAD_ROOT=public/uploads
TEMP_UPLOAD_ROOT=tmp

# Local files served by API at /uploads/ (no AWS required)
PUBLIC_MEDIA_BASE_URL=http://localhost:5000/uploads

MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100
MAX_DATA_UPLOAD_MB=100

MAX_ZIP_UPLOAD_MB=500
MAX_ZIP_UNCOMPRESSED_MB=2048
MAX_ZIP_FILES=10000

MAX_IMAGE_PIXELS=50000000

CACHE_ENABLED=true

CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DETAIL_TTL_SECONDS=600
CACHE_LIST_TTL_SECONDS=300
CACHE_DASHBOARD_TTL_SECONDS=60
CACHE_ADMIN_NOTIFICATIONS_TTL_SECONDS=30
CACHE_ADMIN_SUMMARY_TTL_SECONDS=90
NOTIFICATION_SNAPSHOT_REFRESH_MS=60000
CACHE_NEGATIVE_TTL_SECONDS=30

CACHE_STAMPEDE_LOCK_MS=5000

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

ADMIN_DEFAULT_PAGE_SIZE=25
ADMIN_MAX_PAGE_SIZE=100

RATE_LIMIT_ENABLED=true

RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_PUBLIC_WINDOW=1 minute

RATE_LIMIT_ADMIN_MAX=180
RATE_LIMIT_ADMIN_WINDOW=1 minute

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15 minutes

RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW=1 hour

RATE_LIMIT_IMPORT_MAX=10
RATE_LIMIT_IMPORT_WINDOW=1 hour

QUEUE_PREFIX=weightloss

# BullMQ queue names use "{QUEUE_PREFIX}-{suffix}" (no colons).
QUEUE_EXPORT_CONCURRENCY=2
QUEUE_MEDIA_CONCURRENCY=2
QUEUE_ARCHIVE_CONCURRENCY=1

QUEUE_JOB_ATTEMPTS=3
QUEUE_BACKOFF_MS=3000

API_DOCS_ENABLED=true

TRUST_PROXY=false

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_TOKEN=

API_LEGACY_SUNSET=2027-06-01

LOG_LEVEL=info

SLOW_REQUEST_MS=300
SLOW_DB_QUERY_MS=100

# Firebase (workout reminders + FCM push)
# Use the mobile app's Firebase project service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private key with \n escaped newlines, or use a single line in quotes.
FIREBASE_PRIVATE_KEY=

# Worker cron — checks due reminders every minute
WORKOUT_REMINDERS_CRON_ENABLED=true
WORKOUT_REMINDERS_CRON_INTERVAL_MS=60000

# Legacy S3 keys (also used when STORAGE_DRIVER=s3 — see comments above)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
